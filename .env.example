# =============================================================================
# LTX-2.3 service runtime configuration. Mirrors src/config.py:Settings.
# Copy to .env for local development. In production these come from the
# RunPod pod template / GitHub Actions secrets — env always wins over .env.
# =============================================================================

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Model storage ────────────────────────────────────────────────────────────
MODEL_DIR=/models
# Required: Gemma 3 needs license acceptance at
# https://huggingface.co/google/gemma-3-12b-it-qat-q4_0-unquantized
HF_TOKEN=hf_YOUR_TOKEN_HERE

# ── FP8 / attention / pipeline mode ──────────────────────────────────────────
# "" (BF16, default), "scaled_mm" (H100 W8A8), or "cast" (compatible FP8).
LTX_FP8_MODE=
# "" (auto), "flash_attention_3", or "sdpa" (non-Hopper fallback).
LTX_ATTENTION_TYPE=
# "t2v" or "i2v" — picks the boot-preloaded pipeline side. The other mode
# triggers a ~30-60 s rebuild on first cross-mode request.
LTX_DEFAULT_MODE=i2v
# 1/0 — torch.compile (regional, per transformer block). ~60-120 s warmup
# on first generation, then cached. ~15-30 % Stage 1 speedup.
ENABLE_TORCH_COMPILE=1

# ── TeaCache (training-free diffusion-step caching) ──────────────────────────
# 1/0 — orthogonal to attention backend. DO NOT enable on I2V (quality regression).
ENABLE_TEACACHE=0
# 0.03 ≈ lossless, 0.05 ≈ aggressive (~2× speedup, small quality hit). (0, 1].
TEACACHE_THRESHOLD=0.03
# Comma-separated. stage_2's 3-step distilled schedule rarely benefits.
TEACACHE_STAGES=stage_1

# ── Supabase Storage (optional — service works without it) ───────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key   # NOT the anon key
SUPABASE_BUCKET=ltx-videos
SUPABASE_URL_EXPIRY_SECONDS=604800           # 7 days
