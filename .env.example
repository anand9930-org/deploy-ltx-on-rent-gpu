# HuggingFace (required for model download)
# Gemma 3 requires accepting the license at https://huggingface.co/google/gemma-3-12b-it-qat-q4_0-unquantized
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Supabase Storage (for video upload — optional, service works without it)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key   # NOT the anon key — server-side uploads need service role
SUPABASE_BUCKET=ltx-videos
SUPABASE_URL_EXPIRY_SECONDS=604800           # 7 days

# Model storage (override for custom mount paths)
MODEL_DIR=/models

# Gemma post-load quantization (applied in-memory after LTX-2 loads BF16
# weights from disk). Keeps the on-disk format LTX-2's custom loader
# expects, while shrinking runtime VRAM so the pipeline fits pure-GPU on
# 48 GB cards. BF16 activations are preserved — the DiT sees an unchanged
# interface. See docs/gemma-compat-checklist.md.
#
#   none (default) — BF16 runtime, ~26 GB Gemma, needs 80 GB+ GPU
#   hqq4           — 4-bit HQQ, ~7 GB Gemma, fits 48 GB pure-GPU (first candidate)
#   hqq8           — 8-bit HQQ, ~13 GB Gemma, fits 48 GB pure-GPU, conservative fallback
GEMMA_POST_LOAD_QUANT=none
