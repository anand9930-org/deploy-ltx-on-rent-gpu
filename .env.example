# HuggingFace (required for model download)
# Gemma 3 requires accepting the license at https://huggingface.co/google/gemma-3-12b-it-qat-q4_0-unquantized
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Supabase Storage (for video upload — optional, service works without it)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key   # NOT the anon key — server-side uploads need service role
SUPABASE_BUCKET=ltx-videos
SUPABASE_URL_EXPIRY_SECONDS=604800           # 7 days

# Model storage (override for custom mount paths)
MODEL_DIR=/models

# Gemma text-encoder quantization:
#   w4a16 (default) — RedHatAI GPTQ 4-bit weight-only, ~7 GB, BF16 activations,
#                     enables pure-GPU mode on 40 GB+ cards (skips PCIe streaming)
#   bf16            — Google QAT-dequantized baseline, ~26 GB, requires the
#                     layer-streaming fallback on <40 GB GPUs
GEMMA_QUANT=w4a16
