# HuggingFace (required for model download)
# Gemma 3 requires accepting the license at https://huggingface.co/google/gemma-3-12b-it-qat-q4_0-unquantized
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Supabase Storage (for video upload — optional, service works without it)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key   # NOT the anon key — server-side uploads need service role
SUPABASE_BUCKET=ltx-videos
SUPABASE_URL_EXPIRY_SECONDS=604800           # 7 days

# Model storage (override for custom mount paths)
MODEL_DIR=/models

# TeaCache — diffusion-step caching, ~1.6–2.1× lossless speedup.
# Works on any GPU; orthogonal to attention backend.
ENABLE_TEACACHE=0               # set to 1 to enable
TEACACHE_THRESHOLD=0.03         # 0.03 ≈ lossless, 0.05 ≈ aggressive (~2× speedup)
TEACACHE_STAGES=stage_1         # comma-separated; stage_2 rarely benefits (only 3 steps)

# torch.compile — regional compile (per transformer block) of the LTX
# transformer. Transparent to numerics; pays ~60-120 s compile warmup
# on first generation then caches. Expected ~15-30 % Stage 1 speedup.
ENABLE_TORCH_COMPILE=1          # set to 0 to disable without rebuilding
